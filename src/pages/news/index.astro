---
// news/index.astro — News list page
// Mirrors the publications page layout: a sticky "Jump to Year" sidebar
// beside year-grouped entries.  Each entry reuses the .pub-item shell so
// the two pages stay visually identical:
//   line 1 – the headline (links to the detail page), with the month and
//            year sitting right-aligned where a publication shows its year
//   badge  – the category tag, sitting where a publication shows its DOI
//
// To add a news item: add an entry to src/data/news.ts.  No edits needed here.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { NEWS } from '../../data/news';

// Sorted newest-first by actual date value
function parseDate(d: string): number {
  const fallback = new Date(d.replace('Spring', 'April').replace('Fall', 'October'));
  return isNaN(fallback.getTime()) ? 0 : fallback.getTime();
}
const sorted = [...NEWS].sort((a, b) => parseDate(b.date) - parseDate(a.date));

// Years, newest first, and the items belonging to each
const years = [...new Set(sorted.map(n => n.year))];
const byYear = new Map<number, typeof sorted>();
for (const year of years) {
  byYear.set(year, sorted.filter(n => n.year === year));
}
---
<BaseLayout
  title="News | ImmersionLab — UIUC"
  description="Latest news, announcements, and updates from ImmersionLab at UIUC."
>

  <section class="hero-page">
    <div class="container">
      <span class="section-label">News</span>
      <h1 class="hero-page-title">News &amp; Updates</h1>
      <p class="hero-page-desc">
        Announcements, awards, publications, and other updates from ImmersionLab.
        Click any item to read more.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container pubs-layout">

      <!-- ── Sidebar ── -->
      <aside class="pubs-sidebar">
        <div class="sidebar-card">
          <h3>Jump to Year</h3>
          <nav class="year-nav">
            {years.map(year => (
              <a href={`#year-${year}`} class="year-link">{year}</a>
            ))}
          </nav>
        </div>
      </aside>

      <!-- ── News list ── -->
      <div class="pubs-main">
        {years.map(year => (
          <div id={`year-${year}`} class="year-group">
            <h2 class="year-heading">{year}</h2>
            <div class="pub-list">
              {(byYear.get(year) ?? []).map(item => (
                <article class="pub-item news-item">
                  <div class="pub-body">
                    <p class="pub-title">
                      <a href={`/news/${item.slug}/`}>{item.title}</a>
                    </p>
                    <div class="pub-links">
                      <span class={`tag ${item.tagClass}`}>{item.category}</span>
                    </div>
                  </div>
                  <span class="pub-year">{item.shortDate}</span>
                </article>
              ))}
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

</BaseLayout>
